NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://verifier:verifier@127.0.0.1:5432/verifier
SESSION_TTL_HOURS=12

# Object storage. Locally this is S3Mock from docker-compose.yml,
# which accepts any credentials. On AWS, remove
# S3_ENDPOINT and the two key variables (the SDK then uses its default
# credential chain) and set S3_REGION to the project's selected Region.
S3_BUCKET=verifier-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
