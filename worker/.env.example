DATABASE_URL=postgres://verifier:verifier@127.0.0.1:5432/verifier

# Object storage: same settings as api/.env. On AWS, remove S3_ENDPOINT and the
# two key variables and set S3_REGION to the project's selected Region.
S3_BUCKET=verifier-dev
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:9090
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local

# The Batfish instance this worker is paired with (docker-compose.yml locally).
BATFISH_HOST=127.0.0.1
BATFISH_INSTANCE=local-batfish

# Model access for the agent (https://platform.deepseek.com). Snapshot contents
# and user messages are sent to this provider.
DEEPSEEK_API_KEY=
# deepseek-flash selects DeepSeek V4.1 Flash (default).
AGENT_MODEL=deepseek-flash

# Embeddings for the documentation index (https://platform.openai.com).
# Manual text is sent to this provider when the index is built, and the
# agent's documentation queries are sent to it at search time.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Lab deployment (the deploy worker only: pnpm deploy-worker). Needs Containerlab
# installed and the user in the clab_admins group.
# The router image, e.g. a vrnetlab-built Cisco IOL image. Required for cisco_iol.
LAB_IMAGE=
# cisco_iol (needs LAB_IMAGE) or frr (free image, defaults to quay.io/frrouting/frr:10.2.1;
# snapshots in Batfish's Cumulus layout, like examples/bgp-leak-lab-frr).
# LAB_KIND=cisco_iol
# LAB_USERNAME=admin
# LAB_PASSWORD=admin
# LAB_DIR=~/.local/share/verifier/labs
# LAB_CONVERGE_SECONDS=300
# The lab's management network; pick one no other Docker network uses.
# LAB_MGMT_SUBNET=172.31.255.0/24
